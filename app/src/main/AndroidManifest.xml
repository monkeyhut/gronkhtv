<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Für „Gronkh ist live“; ab Android 13 fragt die App beim ersten Start danach. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Fernseher und Handy aus einer APK: kein Merkmal ist Pflicht. Ohne diese Angaben blendet der Google-TV-Launcher sie aus. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.GronkhTV">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GameActivity"
            android:exported="false" />

        <!-- Drehen und Bild im Bild dürfen die Activity nicht neu aufbauen, sonst bräche das Video ab. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />

        <!-- Bildschirmschoner. Ohne Einstellungen, deshalb ohne android.service.dream-Metadaten; den Namen trägt das Label. -->
        <service
            android:name=".dream.GalleryDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
