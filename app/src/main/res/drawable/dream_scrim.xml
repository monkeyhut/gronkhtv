<?xml version="1.0" encoding="utf-8"?>
<!-- Dunkelt nur die Ecke unter der Uhr ab: radial aus der Ecke unten links, läuft vor den Rändern der Fläche aus. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0"
        android:centerY="1"
        android:gradientRadius="100%"
        android:startColor="#CC000000"
        android:centerColor="#8C000000"
        android:endColor="#00000000" />
</shape>
